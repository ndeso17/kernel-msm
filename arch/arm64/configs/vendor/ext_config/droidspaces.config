# Droidspaces on the moto g57 power (mumba, SM6475).
#
# Only the switches that `droidspaces check` treats as MUST HAVE. Every extra
# option here can move a struct and re-hash the CRCs that the phone's prebuilt
# vendor modules check on load, so the fragment stays deliberately tiny.
#
# Needs include/linux/sched.h to keep sysvsem/sysvshm in the kABI padding.

CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y

# --net=nat gives containers an IPv6 ULA and MASQUERADEs them onto the host.
# The IPv6 stack and ip6tables filter/mangle tables are already in the stock
# config; only the nat table and its MASQUERADE target are missing, so the
# container is handed a link-local address and IPv4 only. Both options are code
# with no ABI-visible struct: measured, module_layout/_dev_err/__put_task_struct
# keep their vendor CRCs. IP6_NF_TARGET_MASQUERADE is backwards-compat and only
# select[]s NETFILTER_XT_TARGET_MASQUERADE, which is already y.
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --hw-access hands the container the host /dev as-is, which needs a devtmpfs
# mounted here for it to copy from. Pure new code in drivers/base/devtmpfs.c:
# measured with tools/abi_probe.sh, 0 of 84 vendor symbols moved.
# CONFIG_DEVTMPFS_MOUNT stays off on purpose: it would make the kernel mount
# devtmpfs over Android's /dev during boot, before ueventd ever runs, and take
# ownership of the device nodes away from init.
CONFIG_DEVTMPFS=y

# --net=macvlan gives the container its own MAC on a host interface. Built in
# rather than =m because the phone carries no module loader path for it and a
# missing .ko would only surface at container start. Driver code only, no
# struct net_device change: measured, 0 of 84 vendor symbols moved.
CONFIG_MACVLAN=y

# Motorola signs the prebuilt vendor modules with a key that cannot be embedded
# here, so GKI signature protection would treat all 442 of them as untrusted and
# refuse roughly 129 of the symbols they import. Loading them is the point.
# CONFIG_MODULE_SIG_PROTECT is not set

# Trimming keeps only the KMI list, which would drop vmlinux exports the vendor
# modules need (submit_bio, proc_create, mem_cgroup_from_id, ...). Keep them all.
# CONFIG_TRIM_UNUSED_KSYMS is not set
